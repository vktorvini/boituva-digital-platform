# Connection string do Supabase (Settings > Database > Connection string > URI)
# Use a senha do banco — NUNCA commite o .env real
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# Município alvo
BDP_MUNICIPIO_NOME=boituva
BDP_MUNICIPIO_IBGE_CODE=3507001
BDP_MUNICIPIO_UF=SP

# Pipeline
BDP_PIPELINE_VERSION=1.1.0
BDP_LOG_LEVEL=INFO
BDP_DRY_RUN=false
