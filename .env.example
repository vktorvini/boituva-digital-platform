# =========================================
# BOITUVA DIGITAL PLATFORM - ROOT ENV FILE
# =========================================

# -----------------------------------------
# Ambiente geral
# -----------------------------------------
APP_NAME=boituva-digital-platform
APP_ENV=development
APP_DEBUG=true

# -----------------------------------------
# Dashboard / Frontend
# Prefixo VITE_ para projetos Vite
# -----------------------------------------
VITE_APP_NAME=Boituva Digital Platform
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------
# Pipeline / Python
# -----------------------------------------
PYTHON_ENV=development
PIPELINE_BASE_DIR=./data-platform/pipeline
PIPELINE_DATA_DIR=./data-platform/pipeline/data
PIPELINE_LOG_DIR=./data-platform/pipeline/logs

# -----------------------------------------
# Fonte de dados TCE
# Ajuste conforme sua implementação real
# -----------------------------------------
TCE_BASE_URL=
TCE_API_KEY=
TCE_TIMEOUT=60
TCE_RETRY_ATTEMPTS=3

# -----------------------------------------
# Persistência analítica
# Pode ser Supabase/Postgres no futuro
# -----------------------------------------
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public

# URL alternativa única, se preferir
DATABASE_URL=

# -----------------------------------------
# DuckDB / processamento local
# -----------------------------------------
DUCKDB_PATH=./data-platform/pipeline/data/analytics.duckdb

# -----------------------------------------
# Saídas padrão por camada
# -----------------------------------------
RAW_DIR=./data-platform/pipeline/data/raw
BRONZE_DIR=./data-platform/pipeline/data/bronze
SILVER_DIR=./data-platform/pipeline/data/silver
GOLD_DIR=./data-platform/pipeline/data/gold

# -----------------------------------------
# Logs
# -----------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------
# Futuras integrações
# -----------------------------------------
OPENAI_API_KEY=